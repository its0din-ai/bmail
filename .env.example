# Copy to .env and fill in real values. Never commit .env.
# Keys are snake_case - see AGENTIC.md naming rules.
# Deployment target: Cloudflare Workers Free plan (no paid-only features).
#
# The Worker cannot read .env at runtime. The deploy script maps bmail_* to
# Worker vars and secrets, and writes .dev.vars for local development.

# Comma-separated domain list. Each entry is domain:mode.
# catch_all: every local part reaches the Worker; new aliases are allowed.
# fixed: only addresses listed in bmail_fixed_addresses; no new aliases.
# Example: mail.example.com:catch_all,inbound.example.net:fixed
bmail_mail_domains=

# Full addresses allowed on fixed domains. The alias is created on first inbound.
# Example: programs@inbound.example.net
bmail_fixed_addresses=

# Domain used by the CLI/MCP when a call omits mail_domain.
# Must be one of bmail_mail_domains.
bmail_default_mail_domain=

# Verified Email Routing destination that receives the mirror copy.
# Must NOT be on any domain in bmail_mail_domains (loop guard).
bmail_forward_to=

# Days to keep aliases, messages, attachments, and raw MIME.
bmail_retention_days=90

# Server-side pepper for agent token hashes. 32+ random bytes, base64.
bmail_token_pepper=

# Operator token for /v1/tokens. Also used by `bmail tokens ...`.
bmail_admin_token=

# Deploy only (not read by the Worker at runtime).
cloudflare_account_id=
cloudflare_worker_name=bmail
cloudflare_d1_database_id=
cloudflare_r2_bucket_name=

# Client / MCP only (not read by the Worker).
# Example: https://bmail.example.workers.dev
bmail_api_url=
bmail_token=

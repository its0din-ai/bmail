# Copy to .env and fill in real values. Never commit .env.
# Keys are snake_case - see AGENTIC.md naming rules.
#
# The Worker cannot read .env at runtime. `pnpm dev` writes .dev.vars,
# and `pnpm deploy:worker` maps these values to Worker vars and secrets.

# Comma-separated recipients the Worker accepts.
# An entry can be a domain (any local part) or a full address (exact).
# Example: mail.example.com,bbounty@programs.example.net
bmail_mail_domains=

# Shared key for the REST API. 16+ characters, random.
bmail_api_key=

# Optional. Forward every caught message to this verified Email Routing
# destination. It must not route back to this Worker. Use `none` to disable.
bmail_forward_to=

# CLI deploy only (`pnpm deploy:worker`). The Worker never reads these at runtime.
# In the dashboard path, configure bindings and variables in the UI instead.
cloudflare_account_id=
cloudflare_worker_name=bmail
cloudflare_r2_bucket_name=bmail-mail
# R2 lifecycle expiry for mail/ and latest/, in days. Defaults to 7 if omitted.
bmail_lifecycle_days=7

# Smoke test only (not read by the Worker).
# Example: https://bmail.example.workers.dev
bmail_api_url=
# Optional default address for the smoke test.
bmail_address=
# Local email injection base. Defaults to bmail_api_url when it is localhost.
bmail_local_email_url=

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-12",
  "keep_vars": true,
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "bmail-mail"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}

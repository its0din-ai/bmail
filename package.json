{
  "name": "bmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "deploy:worker": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "cloudflare": {
    "bindings": {
      "bmail_mail_domains": {
        "description": "Comma-separated allowlist. A domain accepts any local part; a full address is exact. For example: mail.example.com,bbounty@programs.example.net"
      },
      "bmail_api_key": {
        "description": "Shared API key for the REST API. At least 16 characters. Generate one with: openssl rand -hex 32"
      }
    }
  }
}

{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmail",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "bmail-mail"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
